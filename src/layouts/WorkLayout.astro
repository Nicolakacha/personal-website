---
import BaseLayout from './BaseLayout.astro';
const { work } = Astro.props;
---
<BaseLayout title={`${work.data.title} — Nicolas Tei`} description={work.data.deck ?? work.data.description}>
  <article>
    <header class="work-intro text-column">
      <h1>{work.data.title}</h1>
      {work.data.nativeTitle && <p class="meta">{work.data.nativeTitle}</p>}
      {work.data.description && <p class="description">{work.data.description}</p>}
    </header>
    <slot />
  </article>
</BaseLayout>
<style>
  .work-intro { margin-bottom: var(--space-xl); }
  .work-intro .meta { margin-top: var(--space-3xs); }
  .work-intro .description { margin-top: var(--space-sm); }
</style>
