---
import BaseLayout from './BaseLayout.astro';
import ProjectEquipment from '../components/ProjectEquipment.astro';
import { getEntryOgImage } from '../utils/ogImage';
import { workDescription, workStructuredData } from '../utils/seo';
const { work, titleOverride, lang, noindex } = Astro.props;
const displayTitle = titleOverride ?? work.data.title;
// /projects/{slug}/ and /jp/projects/{slug}/ share the same photographs, so
// declare them as language versions of each other rather than duplicates.
const alternates = [
  { hreflang: 'en', href: `/projects/${work.data.routeSlug}/` },
  { hreflang: 'ja', href: `/jp/projects/${work.data.routeSlug}/` },
  { hreflang: 'x-default', href: `/projects/${work.data.routeSlug}/` },
];
const image = await getEntryOgImage(work.data.routeSlug, work.data.sequence, 'works', Astro.site);
const pageLang = lang === 'ja' ? 'ja' : 'en';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const description = workDescription(work, pageLang);
const structuredData = workStructuredData(work, canonicalUrl, pageLang, image);
const mobileEdgeToEdgeWorks = new Set([
  'how-much-silence',
  'dear-world',
  'the-room-was-not-dark',
]);
---
<BaseLayout title={`${displayTitle} — Nicolas Tei`} description={description} image={image} structuredData={structuredData} type="article" lang={lang} noindex={noindex} alternates={alternates}>
  <article class:list={['work-article', { 'mobile-edge-to-edge': mobileEdgeToEdgeWorks.has(work.data.routeSlug) }]}>
    <header class="work-intro text-column">
      <h1>{displayTitle}</h1>
      {work.data.nativeTitle && <p class="meta">{work.data.nativeTitle}</p>}
      {work.data.description && <p class="description">{work.data.description}</p>}
    </header>
    <slot />
    {work.data.equipment && work.data.equipmentPosition !== 'beforeLastImage' && <ProjectEquipment items={work.data.equipment} />}
  </article>
</BaseLayout>
<style>
  /* main's own top/bottom padding (--space-xl) is much wider than its
     left/right padding (--space-sm); pull it back in here so a work page's
     photos get the same thin margin on every side, matching §4.4's intent. */
  .work-article {
    margin-block: calc(var(--space-sm) - var(--space-xl));
  }
  @media (max-width: 767px) {
    .work-article { margin-top: 0; }
    .work-intro { margin-bottom: var(--space-sm); }
    .mobile-edge-to-edge {
      --image-small-max: 100vw;
      --image-medium-max: 100vw;
      --image-large-max: 100vw;
      --image-full-max: 100vw;
    }
    .mobile-edge-to-edge :global(.sequence) {
      margin-left: calc(var(--space-sm) * -1);
      margin-right: calc(var(--space-sm) * -1);
      width: calc(100% + (var(--space-sm) * 2));
    }
  }
  .work-intro { margin-bottom: var(--space-xl); }
  .work-intro h1:lang(ja) { letter-spacing: 0; word-break: auto-phrase; }
  .work-intro .meta { margin-top: var(--space-3xs); }
  .work-intro .description { margin-top: var(--space-sm); }
  @media (min-width: 768px) {
    .work-intro { margin-bottom: var(--space-md); }
    .work-article {
      --image-small-max: 60vw;
      --image-medium-max: 60vw;
      --image-large-max: 60vw;
      --image-full-max: 60vw;
    }
  }
  @media (min-width: 1080px) {
    .work-article {
      --image-small-max: 50vw;
      --image-medium-max: 50vw;
      --image-large-max: 50vw;
      --image-full-max: 50vw;
    }
  }
</style>
