---
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-standard-normal.woff2?url';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getVisibleWorks, withJapaneseTitles } from '../utils/works';
import { INSTAGRAM_URL, PERSON_ID } from '../utils/seo';

interface Props { title: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; bodyClass?: string; lang?: string; alternates?: { hreflang: string; href: string }[]; mobileBackgroundImage?: string; transparentNav?: boolean; canonicalOverride?: string; structuredData?: Record<string, unknown>[]; publishedTime?: Date; }
const {
  title,
  description = 'Photographs and notes by Nicolas Tei.',
  image = new URL('/og-default.jpg', Astro.site).toString(),
  type = 'website',
  noindex = false,
  bodyClass = '',
  lang = 'en',
  alternates = [],
  mobileBackgroundImage,
  transparentNav = false,
  canonicalOverride,
  structuredData = [],
  publishedTime,
} = Astro.props;
const canonical = new URL(canonicalOverride ?? Astro.url.pathname, Astro.site);
const works = await getVisibleWorks();
const isJp = Astro.url.pathname === '/jp' || Astro.url.pathname.startsWith('/jp/');
const navBasePath = isJp ? '/jp' : '';
const navWorks = isJp ? withJapaneseTitles(works) : works;
const ogLocales: Record<string, string> = { en: 'en_US', ja: 'ja_JP', 'zh-TW': 'zh_TW', zh: 'zh_TW' };
const ogLocale = ogLocales[lang] ?? 'en_US';
const ogAlternateLocales = [...new Set(alternates
  .filter((alternate) => alternate.hreflang !== 'x-default')
  .map((alternate) => ogLocales[alternate.hreflang])
  .filter((locale): locale is string => Boolean(locale) && locale !== ogLocale))];
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).toString(),
      name: 'Nicolas Tei',
      url: Astro.site?.toString(),
      inLanguage: ['en', 'ja', 'zh-TW'],
      publisher: { '@id': PERSON_ID },
    },
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Nicolas Tei',
      url: Astro.site?.toString(),
      jobTitle: 'Photographer',
      homeLocation: { '@type': 'Place', name: 'Osaka, Japan' },
      sameAs: [INSTAGRAM_URL],
    },
    ...structuredData,
  ],
};
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1B1917" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.href, Astro.site)} />
    ))}
    <meta property="og:site_name" content="Nicolas Tei" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} is:inline />
  </head>
  <body class={bodyClass}>
    {mobileBackgroundImage && (
      <div class="mobile-bg-image" style={`background-image: url(${mobileBackgroundImage})`}></div>
    )}
    <SiteHeader currentPath={Astro.url.pathname} works={navWorks} transparentNav={transparentNav} basePath={navBasePath} />
    <div class="page-content" data-page-content>
      <main><slot /></main>
      <SiteFooter />
    </div>
    <script>
      document.querySelectorAll('img.fade-img').forEach((img) => {
        const el = img as HTMLImageElement;
        if (el.complete) el.classList.add('is-loaded');
        else el.addEventListener('load', () => el.classList.add('is-loaded'), { once: true });
      });
      // Deters casual saving only — the file is still reachable via DevTools or its URL.
      document.addEventListener('contextmenu', (e) => {
        if (e.target instanceof HTMLImageElement && e.target.classList.contains('fade-img')) e.preventDefault();
      });
    </script>
  </body>
</html>

<style>
  .mobile-bg-image {
    display: none;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    inset: 0;
    position: fixed;
    z-index: -1;
  }
  @media (max-width: 767px) {
    .mobile-bg-image { display: block; }
  }
</style>
