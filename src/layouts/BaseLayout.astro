---
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-standard-normal.woff2?url';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props { title: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; bodyClass?: string; }
const {
  title,
  description = 'Photographs and notes by Nicolas Tei.',
  image = new URL('/og-default.jpg', Astro.site).toString(),
  type = 'website',
  noindex = false,
  bodyClass = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Nicolas Tei',
      url: Astro.site?.toString(),
    },
    {
      '@type': 'Person',
      name: 'Nicolas Tei',
      url: Astro.site?.toString(),
      jobTitle: 'Photographer',
    },
  ],
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1B1917" />
    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} is:inline />
  </head>
  <body class={bodyClass}>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main><slot /></main>
    <SiteFooter />
    <script>
      document.querySelectorAll('img.fade-img').forEach((img) => {
        const el = img as HTMLImageElement;
        if (el.complete) el.classList.add('is-loaded');
        else el.addEventListener('load', () => el.classList.add('is-loaded'), { once: true });
      });
      // Deters casual saving only — the file is still reachable via DevTools or its URL.
      document.addEventListener('contextmenu', (e) => {
        if (e.target instanceof HTMLImageElement && e.target.classList.contains('fade-img')) e.preventDefault();
      });
    </script>
  </body>
</html>
