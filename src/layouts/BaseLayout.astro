---
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-standard-normal.woff2?url';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props { title: string; description?: string; }
const { title, description = 'Photographs and notes by Nicolas Tei.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-default.jpg', Astro.site)} />
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main><slot /></main>
    <SiteFooter />
    <script>
      document.querySelectorAll('img.fade-img').forEach((img) => {
        const el = img as HTMLImageElement;
        if (el.complete) el.classList.add('is-loaded');
        else el.addEventListener('load', () => el.classList.add('is-loaded'), { once: true });
      });
    </script>
  </body>
</html>
