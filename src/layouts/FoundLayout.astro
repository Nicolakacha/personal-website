---
import BaseLayout from './BaseLayout.astro';
import { getEntryOgImage } from '../utils/ogImage';
const { item } = Astro.props;
const image = await getEntryOgImage(item.data.routeSlug, item.data.sequence, 'found', Astro.site);
---
<BaseLayout title={`${item.data.title} — Nicolas Tei`} description={item.data.deck ?? item.data.description} image={image} type="article" noindex>
  <article class="work-article">
    <header class="found-intro text-column">
      <h1>{item.data.title}</h1>
      <p class="meta">
        {item.data.year}
        {item.data.nativeTitle && <> · {item.data.nativeTitle}</>}
      </p>
      {item.data.description && <p class="description">{item.data.description}</p>}
      {item.data.provenance && <p class="provenance meta">{item.data.provenance}</p>}
    </header>
    <slot />
  </article>
</BaseLayout>
<style>
  .work-article { margin-block: calc(var(--space-sm) - var(--space-xl)); }
  @media (max-width: 767px) {
    .work-article { margin-top: calc(var(--space-sm) - var(--space-lg)); }
  }
  .found-intro { margin-bottom: var(--space-xl); }
  .found-intro .meta { margin-top: var(--space-3xs); }
  .found-intro .description { margin-top: var(--space-sm); }
  .found-intro .provenance { margin-top: var(--space-sm); }
</style>
