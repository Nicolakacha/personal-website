---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteContent from '../../../components/NoteContent.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) =>
    data.status === 'published' && data.lang === 'en'
  );
  return notes.map((note) => ({
    params: { lang: note.data.lang, slug: note.data.routeSlug },
    props: { note },
  }));
}

const { note } = Astro.props;
const translations = await getCollection('notes', ({ data }) =>
  data.status === 'published' && data.translationKey === note.data.translationKey
);
const languageOrder = ['zh', 'en', 'ja'] as const;
const hrefFor = (code: typeof languageOrder[number]) =>
  code === 'zh' ? `/notes/${note.data.routeSlug}/` :
  code === 'ja' ? `/jp/notes/${note.data.routeSlug}/` :
  `/${code}/notes/${note.data.routeSlug}/`;
const availableLanguages = languageOrder.filter((code) => translations.some((entry) => entry.data.lang === code));
// The Japanese version lives at /jp (a full site), so it isn't offered as a
// switcher option here — it's reached from the "日本語サイト" link in the main nav.
const languageLinks = availableLanguages
  .filter((code) => code !== 'ja')
  .map((code) => ({ code, href: hrefFor(code) }));
const alternates = [
  ...availableLanguages.map((code) => ({
    hreflang: code === 'zh' ? 'zh-TW' : code,
    href: hrefFor(code),
  })),
  { hreflang: 'x-default', href: `/notes/${note.data.routeSlug}/` },
];
---

<BaseLayout title={`${note.data.title ?? 'Note'} — Nicolas Tei`} description={note.data.description} lang={note.data.lang} alternates={alternates}>
  <NoteContent note={note} languageLinks={languageLinks} />
</BaseLayout>
