---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndexList from '../../components/WorkIndexList.astro';
import { getVisibleWorks } from '../../utils/works';

const works = await getVisibleWorks();
---

<BaseLayout
  title="Projects — Nicolas Tei"
  description="Photography by Nicolas Tei — sequences of photographs presented as a photo-book, based in Japan."
  bodyClass="footer-after-fold"
>
  <section class="page-grid">
    <h1 class="sr-only">Projects</h1>
    <WorkIndexList works={works} />
  </section>
</BaseLayout>
