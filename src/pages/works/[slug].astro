---
import { getCollection } from 'astro:content';
import Sequence from '../../components/Sequence.astro';
import WorkImageGallery from '../../components/WorkImageGallery.astro';
import WorkLayout from '../../layouts/WorkLayout.astro';
export async function getStaticPaths() { const works = await getCollection('works', ({ data }) => data.status !== 'hidden'); return works.map((work) => ({ params: { slug: work.data.routeSlug }, props: { work } })); }
const { work } = Astro.props;
---
<WorkLayout work={work}>
  {work.data.routeSlug === 'inhabitant-portraits'
    ? <WorkImageGallery sequence={work.data.sequence} workSlug={work.data.routeSlug} />
    : work.data.sequence.length > 0 && (
      <Sequence
        sequence={work.data.sequence}
        workSlug={work.data.routeSlug}
        viewportFrames={work.data.routeSlug !== 'the-room-was-not-dark'}
      />
    )}
</WorkLayout>
