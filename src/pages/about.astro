---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../components/AboutContent.astro';

const about = await getEntry('about', 'index');
if (!about) throw new Error('Missing About content');
---
<BaseLayout
  title="About — Nicolas Tei"
  description="Nicolas Tei is a photographer from Taiwan, temporarily based in Osaka, Japan."
  bodyClass="footer-after-fold"
  alternates={[
    { hreflang: 'en', href: '/about/' },
    { hreflang: 'ja', href: '/ja/about/' },
    { hreflang: 'zh-TW', href: '/zh/about/' },
    { hreflang: 'x-default', href: '/about/' },
  ]}
>
  <AboutContent about={about} />
</BaseLayout>
