---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutContent from '../../components/AboutContent.astro';

const about = await getEntry('about', 'index-zh');
if (!about) throw new Error('Missing Chinese About content');
---

<BaseLayout
  title="關於 Nicolas Tei — 攝影師"
  description="Nicolas Tei 是來自台灣的攝影師，目前暫居大阪。"
  bodyClass="footer-after-fold"
  lang="zh-TW"
  alternates={[
    { hreflang: 'en', href: '/about/' },
    { hreflang: 'ja', href: '/jp/about/' },
    { hreflang: 'zh-TW', href: '/zh/about/' },
    { hreflang: 'x-default', href: '/about/' },
  ]}
>
  <AboutContent about={about} />
</BaseLayout>
