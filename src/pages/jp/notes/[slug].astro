---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteContent from '../../../components/NoteContent.astro';
import { noteStructuredData } from '../../../utils/seo';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.status === 'published' && data.lang === 'ja');
  return notes.map((note) => ({ params: { slug: note.data.routeSlug }, props: { note } }));
}

const { note } = Astro.props;
const translations = await getCollection('notes', ({ data }) =>
  data.status === 'published' && data.translationKey === note.data.translationKey
);
const languageOrder = ['zh', 'en', 'ja'] as const;
const hrefFor = (code: typeof languageOrder[number]) =>
  code === 'zh' ? `/notes/${note.data.routeSlug}/` :
  code === 'ja' ? `/jp/notes/${note.data.routeSlug}/` :
  `/${code}/notes/${note.data.routeSlug}/`;
const alternates = [
  ...languageOrder
    .filter((code) => translations.some((entry) => entry.data.lang === code))
    .map((code) => ({ hreflang: code === 'zh' ? 'zh-TW' : code, href: hrefFor(code) })),
  { hreflang: 'x-default', href: `/notes/${note.data.routeSlug}/` },
];
const structuredData = noteStructuredData(note, new URL(Astro.url.pathname, Astro.site));
---
<BaseLayout
  title={`${note.data.title ?? 'Note'} — Nicolas Tei`}
  description={note.data.description}
  type="article"
  publishedTime={note.data.date}
  structuredData={structuredData}
  lang="ja"
  alternates={alternates}
>
  <NoteContent note={note} languageLinks={[]} />
</BaseLayout>
