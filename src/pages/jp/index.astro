---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndexList from '../../components/WorkIndexList.astro';
import { getVisibleWorks, withJapaneseTitles } from '../../utils/works';
import homeMobileBackground from '../../assets/background/home-mobile.jpg';

const works = await getVisibleWorks();
const jpWorks = withJapaneseTitles(works);
const mobileBackground = await getImage({ src: homeMobileBackground, format: 'webp', width: 1200, quality: 72 });
---
<BaseLayout
  title="Nicolas Tei"
  description="写真家 Nicolas Teiの作品。日本を拠点に制作された、フォトブックとして構成される写真のシークエンス。"
  mobileBackgroundImage={mobileBackground.src}
  transparentNav
  lang="ja"
  alternates={[
    { hreflang: 'en', href: '/' },
    { hreflang: 'ja', href: '/jp/' },
    { hreflang: 'x-default', href: '/' },
  ]}
>
  <section class="page-grid">
    <h1 class="sr-only">Projects</h1>
    <WorkIndexList works={jpWorks} dividers basePath="/jp/projects" />
  </section>
</BaseLayout>
