---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkIndexList from '../../../components/WorkIndexList.astro';
import { getVisibleWorks, withJapaneseTitles } from '../../../utils/works';

const works = await getVisibleWorks();
const jpWorks = withJapaneseTitles(works);
---
<BaseLayout
  title="Projects — Nicolas Tei"
  description="写真家 Nicolas Teiによる作品一覧。日本を拠点に制作された、フォトブックとして構成される写真のシークエンス。"
  bodyClass="footer-after-fold"
  lang="ja"
>
  <section class="page-grid">
    <h1 class="sr-only">Projects</h1>
    <WorkIndexList works={jpWorks} basePath="/jp/projects" />
  </section>
</BaseLayout>
