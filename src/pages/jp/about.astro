---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutContent from '../../components/AboutContent.astro';

const about = await getEntry('about', 'index-ja');
if (!about) throw new Error('Missing Japanese About content');
---
<BaseLayout
  title="Nicolas Teiについて — 写真家"
  description="Nicolas Teiは台湾出身の写真家で、現在は一時的に大阪を拠点に活動しています。"
  bodyClass="footer-after-fold"
  lang="ja"
  alternates={[
    { hreflang: 'en', href: '/about/' },
    { hreflang: 'ja', href: '/jp/about/' },
    { hreflang: 'zh-TW', href: '/zh/about/' },
    { hreflang: 'x-default', href: '/about/' },
  ]}
>
  <AboutContent about={about} showLanguageSwitcher={false} />
</BaseLayout>
