---
import ResponsiveImage from './ResponsiveImage.astro';
const { block, index, workSlug, collection = 'works', isLast = false } = Astro.props;
const effectiveAlign = ['large', 'full'].includes(block.size) ? 'center' : block.align;
const gapToken = ({ tight: 'xs', normal: 'sm', large: 'lg', pause: 'pause' } as Record<string, string>)[block.gapAfter] ?? 'sm';
// The last block's own gapAfter is meant for spacing *between* blocks, not the
// page's trailing margin (that's fixed, see main/work-article) — spec §5.6.
const gapValue = isLast ? '0px' : `var(--space-${gapToken})`;
---
<figure class:list={['sequence-image', `size-${block.size}`, `align-${effectiveAlign}`]} style={`--gap-after: ${gapValue}`}>
  <ResponsiveImage src={`${workSlug}/${block.src}`} alt={block.alt} decorative={block.decorative} size={block.size} eager={index < 2} priority={index === 0} collection={collection} />
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>
<style>
  figure { margin: 0 auto var(--gap-after); width: 100%; } figcaption { color: var(--color-muted); font-size: var(--font-size-small); margin-top: var(--space-2xs); }
  .size-small { max-width: var(--image-small-max); } .size-medium { max-width: var(--image-medium-max); } .size-large { max-width: var(--image-large-max); } .size-full { max-width: var(--image-full-max); }
  @media (min-width: 1080px) { .align-left { margin-left: 0; margin-right: auto; } .align-right { margin-left: auto; margin-right: 0; } }
</style>




