---
import { Picture } from 'astro:assets';

interface Props {
  src: string;
  alt?: string;
  decorative?: boolean;
  size: 'small' | 'medium' | 'large' | 'full';
  eager?: boolean;
  priority?: boolean;
}
const { src, alt = '', decorative = false, size, eager = false, priority = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/works/**/*.{jpg,jpeg,png}',
  { eager: true }
);
const image = images[`/src/assets/works/${src}`];
if (!image) throw new Error(`Missing work image: ${src}`);

const widthsBySize: Record<Props['size'], number[]> = {
  small: [480, 960],
  medium: [760, 1140, 1520],
  large: [1040, 1560, 2080],
  full: [1280, 1920, 2560],
};
const sizesBySize: Record<Props['size'], string> = {
  small: '(max-width: 767px) 80vw, min(52vw, 480px)',
  medium: '(max-width: 767px) 72vw, min(72vw, 760px)',
  large: '(max-width: 767px) 92vw, min(92vw, 1040px)',
  full: '(max-width: 767px) 96vw, min(96vw, 1280px)',
};

// Never upscale past the source image's real dimensions (spec §4.4 / §9.2).
const requestedWidths = widthsBySize[size].filter((w) => w <= image.default.width);
const widths = requestedWidths.length > 0 ? requestedWidths : [image.default.width];
---
<Picture
  src={image.default}
  formats={['avif', 'webp', 'jpeg']}
  widths={widths}
  sizes={sizesBySize[size]}
  quality={82}
  alt={decorative ? '' : alt}
  aria-hidden={decorative ? 'true' : undefined}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
/>
