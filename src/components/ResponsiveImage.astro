---
import { Picture } from 'astro:assets';

interface Props {
  src: string;
  alt?: string;
  decorative?: boolean;
  size: 'small' | 'medium' | 'large' | 'full';
  eager?: boolean;
  priority?: boolean;
  collection?: 'works' | 'found';
}
const { src, alt = '', decorative = false, size, eager = false, priority = false, collection = 'works' } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/{works,found}/**/*.{jpg,jpeg,png}',
  { eager: true }
);
const image = images[`/src/assets/${collection}/${src}`];
if (!image) throw new Error(`Missing ${collection} image: ${src}`);

const widthsBySize: Record<Props['size'], number[]> = {
  small: [560, 1120],
  medium: [1000, 1760, 2560],
  large: [1300, 1760, 2560],
  full: [1760, 2560],
};
const sizesBySize: Record<Props['size'], string> = {
  small: '(max-width: 767px) 80vw, min(56vw, 560px)',
  medium: '(max-width: 1079px) 98vw, min(60vw, 1000px)',
  large: '(max-width: 1079px) 98vw, min(80vw, 1300px)',
  full: 'min(98vw, 1760px)',
};
const workSizesBySize: Record<Props['size'], string> = {
  small: '(max-width: 767px) 80vw, (max-width: 1079px) 60vw, 40vw',
  medium: '(max-width: 767px) 98vw, (max-width: 1079px) 60vw, 40vw',
  large: '(max-width: 767px) 98vw, (max-width: 1079px) 60vw, 40vw',
  full: '(max-width: 767px) 98vw, (max-width: 1079px) 60vw, 40vw',
};
const sizes = collection === 'works' ? workSizesBySize[size] : sizesBySize[size];

// Never upscale past the source image's real dimensions (spec §4.4 / §9.2).
const requestedWidths = widthsBySize[size].filter((w) => w <= image.default.width);
const widths = requestedWidths.length > 0 ? requestedWidths : [image.default.width];
---
<Picture
  src={image.default}
  formats={['avif', 'webp', 'jpeg']}
  widths={widths}
  sizes={sizes}
  quality={82}
  alt={decorative ? '' : alt}
  aria-hidden={decorative ? 'true' : undefined}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class="fade-img"
/>
