---
import { INSTAGRAM_URL } from '../utils/seo';
const instagram = INSTAGRAM_URL;
const email = 'nicolakacha@gmail.com';
const year = new Date().getFullYear();
---
<footer id="site-footer" class="site-footer">
  <span>&copy; {year} Nicolas Tei. All rights reserved.</span>
  <div class="links">
    {instagram && (
      <a href={instagram} rel="me" aria-label="Instagram" title="Instagram">
        <span class="link-label">Instagram</span>
        <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle class="icon-dot" cx="17.4" cy="6.7" r="1" />
        </svg>
      </a>
    )}
    {email && (
      <a href={`mailto:${email}`} aria-label="Email" title="Email">
        <span class="link-label">Email</span>
        <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4.5 7 7.5 6 7.5-6" />
        </svg>
      </a>
    )}
  </div>
</footer>

<style>
  .site-footer {
    align-items: center;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: row;
    gap: var(--space-sm);
    justify-content: space-between;
    margin: 0 var(--space-sm);
    padding: var(--space-md) 0;
    color: var(--color-muted);
    font-size: var(--font-size-small);
    letter-spacing: 0.02em;
  }
  .links { align-items: center; display: flex; flex-shrink: 0; flex-wrap: nowrap; gap: var(--space-3xs); }
  .link-label { display: none; }
  .site-footer a {
    align-items: center;
    color: var(--color-muted);
    display: inline-flex;
    height: 28px;
    justify-content: center;
    width: 28px;
  }
  .site-footer svg {
    fill: none;
    height: 14px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
    width: 14px;
  }
  .site-footer .icon-dot { fill: currentColor; stroke: none; }
  .site-footer a:hover, .site-footer a:focus-visible { color: var(--color-fg); }
  @media (min-width: 768px) {
    .site-footer { align-items: center; flex-direction: row; gap: var(--space-md); justify-content: center; margin-inline: 0; padding-block: 16px; padding-inline: var(--space-sm); }
    .links { gap: var(--space-xs) var(--space-md); }
    .link-label { display: inline; }
    .link-icon { display: none; }
    .site-footer a { height: auto; width: auto; }
  }
</style>
