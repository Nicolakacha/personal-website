---
const instagram = import.meta.env.PUBLIC_INSTAGRAM_URL;
const email = import.meta.env.PUBLIC_EMAIL;
const hasLinks = Boolean(instagram || email);
---
{hasLinks && (
  <footer class="site-footer">
    {instagram && <a href={instagram} rel="me">Instagram</a>}
    {email && <a href={`mailto:${email}`}>Email</a>}
  </footer>
)}

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0 var(--space-sm);
    padding: var(--space-md) 0 var(--space-lg);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    letter-spacing: 0.02em;
  }
  .site-footer a { color: var(--color-muted); }
  .site-footer a:hover, .site-footer a:focus-visible { color: var(--color-fg); }
</style>
