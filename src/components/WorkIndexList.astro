---
import type { CollectionEntry } from 'astro:content';
interface Props { works: CollectionEntry<'works'>[]; dividers?: boolean; }
const { works, dividers = false } = Astro.props;
---
{works.length > 0 && (
  <ul class:list={[{ 'has-dividers': dividers }]}>
    {works.map((work) => (
      <li>
        <div class="row">
          <a href={`/projects/${work.data.routeSlug}/`}>{work.data.title}</a>
          {work.data.nativeTitle && <span class="meta">{work.data.nativeTitle}</span>}
        </div>
        {work.data.deck && <p class="deck meta">{work.data.deck}</p>}
      </li>
    ))}
  </ul>
)}
<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: clamp(2rem, 4.5vw, 5rem); }
  li:last-child { margin-bottom: 0; }
  .has-dividers li:not(:last-child) {
    border-bottom: 1px solid rgba(237, 234, 227, 0.25);
    padding-bottom: var(--space-sm);
  }
  .has-dividers .row a { font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.6rem); }
  .row { display: block; }
  .row a {
    display: inline-block;
    font-size: clamp(1.9rem, 1.35rem + 1.8vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    overflow-wrap: normal;
    transition: opacity 160ms ease;
    width: 100%;
  }
  .row a:hover, .row a:focus-visible { opacity: 0.62; text-decoration: none; }
  .row .meta { display: block; margin-top: var(--space-2xs); }
  .deck { display: none; }
  @media (max-width: 767px) {
    .row a:active { opacity: 0.62; }
  }
  @media (max-width: 420px) {
    li { margin-bottom: var(--space-lg); }
    .row a { font-size: clamp(1.9rem, 8.5vw, 2.3rem); }
    .has-dividers .row a { font-size: clamp(1.5rem, 7vw, 1.9rem); }
  }
  @media (prefers-reduced-motion: reduce) { .row a { transition: none; } }
</style>
