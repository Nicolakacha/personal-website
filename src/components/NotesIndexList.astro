---
import type { CollectionEntry } from 'astro:content';
interface Props { notes: CollectionEntry<'notes'>[]; }
const { notes } = Astro.props;
---
<ul>
  {notes.map((note) => (
    <li>
      <time class="meta" datetime={note.data.date.toISOString()}>
        {note.data.date.toISOString().slice(0, 10)}
      </time>
      <a href={`/notes/${note.data.routeSlug}/`}>{note.data.title ?? '—'}</a>
    </li>
  ))}
</ul>
<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-sm); margin-bottom: var(--space-sm); }
  li:last-child { margin-bottom: 0; }
  time { flex-shrink: 0; }
</style>
