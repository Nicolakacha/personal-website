---
import SequenceBreak from './SequenceBreak.astro';
import SequenceImage from './SequenceImage.astro';
import SequencePair from './SequencePair.astro';
const { sequence, workSlug, collection = 'works' } = Astro.props;
---
<section class="sequence" aria-label="Photograph sequence">
  {sequence.map((block: any, index: number) => {
    const isLast = index === sequence.length - 1;
    return block.type === 'image' ? <SequenceImage block={block} index={index} workSlug={workSlug} collection={collection} isLast={isLast} /> : block.type === 'pair' ? <SequencePair block={block} index={index} workSlug={workSlug} collection={collection} isLast={isLast} /> : <SequenceBreak size={block.size} />;
  })}
</section>
<style>.sequence { margin: 0 auto; max-width: var(--width-content); }</style>



