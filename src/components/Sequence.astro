---
import SequenceBreak from './SequenceBreak.astro';
import SequenceImage from './SequenceImage.astro';
import SequencePair from './SequencePair.astro';
const { sequence, workSlug, collection = 'works', viewportFrames: viewportFramesProp } = Astro.props;
const viewportFrames = viewportFramesProp ?? collection === 'works';
---
<section class="sequence" aria-label="Photograph sequence">
  {sequence.map((block: any, index: number) => {
    const isLast = index === sequence.length - 1;
    return block.type === 'image' ? <SequenceImage block={block} index={index} workSlug={workSlug} collection={collection} isLast={isLast} viewportFrame={viewportFrames} showScrollHint={viewportFrames && index === 0} /> : block.type === 'pair' ? <SequencePair block={block} index={index} workSlug={workSlug} collection={collection} isLast={isLast} viewportFrame={viewportFrames} showScrollHint={viewportFrames && index === 0} /> : <SequenceBreak size={block.size} />;
  })}
</section>
<script>
  // On touch browsers the toolbar sliding in and out changes innerHeight mid-scroll. Frame sizes are
  // svh-based, so every frame would resize with it and the page jumps when the scroll direction flips.
  // Pin the unit to the height measured at load and re-measure only when the width changes (rotation).
  if (matchMedia('(pointer: coarse)').matches) {
    let pinnedWidth = 0;
    const pinUnit = () => {
      if (window.innerWidth === pinnedWidth) return;
      pinnedWidth = window.innerWidth;
      document.documentElement.style.setProperty('--svh-unit', `${window.innerHeight / 100}px`);
    };
    pinUnit();
    window.addEventListener('resize', pinUnit);
  }
  const hints = document.querySelectorAll<HTMLElement>('[data-scroll-hint]');
  const hideHints = () => {
    if (window.scrollY <= 30) return;
    hints.forEach((hint) => hint.classList.add('is-hidden'));
    window.removeEventListener('scroll', hideHints);
  };
  hideHints();
  window.addEventListener('scroll', hideHints, { passive: true });
</script>
<style>.sequence { margin: 0 auto; max-width: var(--width-content); }</style>
