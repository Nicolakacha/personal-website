---
interface Props { currentPath?: string; }
const { currentPath = '' } = Astro.props;
---
<header class="site-header">
  <a class="site-title" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Nicolas Tei</a>
  <nav aria-label="Primary navigation">
    {/* Found nav entry hidden for now — no content yet; routes still exist at /found/. */}
    <a href="/notes/" aria-current={currentPath.startsWith('/notes') ? 'page' : undefined}>Notes</a>
    <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>About</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    justify-content: space-between;
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .site-title {
    font-weight: 500;
    font-size: var(--font-size-index);
    letter-spacing: var(--letter-spacing-title);
  }
  nav { display: flex; gap: var(--space-sm); }
  nav a {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    letter-spacing: 0.02em;
  }
  nav a:hover, nav a:focus-visible { color: var(--color-fg); }
  nav a[aria-current='page'] {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  @media (min-width: 768px) {
    .site-header { padding-block: 16px; }
  }
  @media (max-width: 767px) {
    .site-title { font-size: var(--font-size-body); font-weight: 400; opacity: 0.82; }
    nav { margin-block: -13px; }
    nav a {
      align-items: center;
      display: inline-flex;
      min-height: 44px;
      padding-inline: 4px;
    }
  }
</style>
