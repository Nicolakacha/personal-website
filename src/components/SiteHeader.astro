---
interface Props { currentPath?: string; }
const { currentPath = '' } = Astro.props;
---
<header class="site-header">
  <a class="site-title" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Nicolas Tei</a>
  <nav aria-label="Primary navigation">
    <a href="/notes/" aria-current={currentPath.startsWith('/notes') ? 'page' : undefined}>Notes</a>
    <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>About</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    justify-content: space-between;
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .site-title {
    font-weight: 500;
    font-size: var(--font-size-index);
    letter-spacing: var(--letter-spacing-title);
  }
  nav { display: flex; gap: var(--space-sm); }
  nav a {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    letter-spacing: 0.02em;
  }
  nav a:hover, nav a:focus-visible { color: var(--color-fg); }
  @media (max-width: 420px) {
    .site-header { display: block; }
    nav { margin-top: var(--space-xs); }
  }
</style>
