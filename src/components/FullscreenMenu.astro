---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentPath?: string;
  works: CollectionEntry<'works'>[];
  basePath?: string;
}

const { currentPath = '', works, basePath = '' } = Astro.props;
const normalizePath = (path: string) => path === '/' ? path : `${path.replace(/\/$/, '')}/`;
const path = normalizePath(currentPath);
const homeHref = `${basePath}/`;
const projectsHref = `${basePath}/projects/`;
const foundHref = `${basePath}/found/`;
const notesHref = `${basePath}/notes/`;
const aboutHref = `${basePath}/about/`;
const isJp = basePath === '/jp';
---

<div class="site-menu" id="site-menu" data-site-menu hidden>
  <nav class="site-menu-inner" aria-label="Site directory">
    <div class="site-menu-primary">
      <a href={homeHref} aria-current={path === homeHref || path === projectsHref ? 'page' : undefined}>Projects</a>
      <a href={foundHref} aria-current={path === foundHref ? 'page' : undefined}>Found</a>
      <a href={notesHref} aria-current={path.includes(notesHref) ? 'page' : undefined}>Notes</a>
      <a href={aboutHref} aria-current={path.endsWith(aboutHref) ? 'page' : undefined}>About</a>
      {isJp
        ? <a class="site-menu-lang-link" href="/" lang="en">English site</a>
        : <a class="site-menu-lang-link" href="/jp/" lang="ja">日本語サイト</a>}
    </div>

    <div class="site-menu-projects">
      <p class="site-menu-label">Index</p>
      <ul>
        {works.map((work) => {
          const href = `${basePath}/projects/${work.data.routeSlug}/`;
          return (
            <li>
              <a href={href} aria-current={path === href ? 'page' : undefined}>
                {work.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</div>

<style>
  .site-menu {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-lg) var(--space-sm) calc(var(--space-lg) + env(safe-area-inset-bottom));
  }
  .site-menu-inner {
    display: grid;
    gap: var(--space-lg);
    margin: 0 auto;
    max-width: var(--width-content);
  }
  .site-menu-primary {
    align-content: start;
    display: grid;
    gap: var(--space-2xs);
  }
  .site-menu-primary a {
    font-size: var(--font-size-title);
    line-height: 1.2;
    width: fit-content;
  }
  .site-menu-primary a.site-menu-lang-link {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    margin-top: var(--space-2xs);
  }
  .site-menu-label {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    margin-bottom: var(--space-sm);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li { margin-bottom: var(--space-xs); }
  li:last-child { margin-bottom: 0; }
  li:not(:last-child) {
    border-bottom: 1px solid rgba(237, 234, 227, 0.25);
    padding-bottom: var(--space-xs);
  }
  .site-menu-projects a {
    display: inline-block;
    font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.6rem);
    letter-spacing: var(--letter-spacing-title);
    line-height: 1.18;
  }
  .site-menu-projects a:lang(ja) { letter-spacing: 0; word-break: auto-phrase; }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  @media (min-width: 768px) {
    .site-menu { padding-block: clamp(4rem, 11vh, 8rem); }
    .site-menu-inner {
      grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 2fr);
      gap: var(--space-xl);
    }
    .site-menu-label { display: none; }
    li { margin-bottom: var(--space-sm); }
    li:not(:last-child) { padding-bottom: var(--space-sm); }
    .site-menu-projects a {
      font-size: clamp(1.4rem, 1.15rem + 0.8vw, 2rem);
    }
  }
</style>
