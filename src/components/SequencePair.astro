---
import ResponsiveImage from './ResponsiveImage.astro';
const { block, index, workSlug, collection = 'works' } = Astro.props;
const ratioClass = `ratio-${block.ratio}`;
const gapToken = ({ tight: 'sm', normal: 'lg', large: 'xl', pause: 'pause' } as Record<string, string>)[block.gapAfter] ?? 'lg';
---
<figure class:list={['sequence-pair', `size-${block.size}`, ratioClass]} style={`--gap-after: var(--space-${gapToken})`}>
  {block.images.map((image: any, imageIndex: number) => <div><ResponsiveImage src={`${workSlug}/${image.src}`} alt={image.alt} decorative={image.decorative} size={block.size} eager={index < 2} priority={index === 0 && imageIndex === 0} collection={collection} /></div>)}
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>
<style>
  figure { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin: 0 auto var(--gap-after); width: 100%; } figure > div { flex: 1 1 0; min-width: 0; } figcaption { color: var(--color-muted); flex-basis: 100%; font-size: var(--font-size-small); }
  .size-small { max-width: var(--image-small-max); } .size-medium { max-width: var(--image-medium-max); } .size-large { max-width: var(--image-large-max); }
  .ratio-left-heavy > :first-child { flex-grow: 1.4; } .ratio-right-heavy > :nth-child(2) { flex-grow: 1.4; }
  @media (max-width: 767px) { figure { display: grid; gap: var(--space-2xs); } figure > div { width: 100%; } .ratio-left-heavy > :first-child, .ratio-right-heavy > :nth-child(2) { flex-grow: 1; } }
</style>




